{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
<url>
  <loc>{{ site.Home.Permalink }}</loc>
  {{- if not site.Home.Lastmod.IsZero }}
  <lastmod>{{ site.Home.Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</lastmod>
  {{- end }}
</url>
{{ range site.RegularPages }}
{{ if ne .RelPermalink "/archives/" }}
<url>
  <loc>{{ .Permalink }}</loc>
  {{- if not .Lastmod.IsZero }}
  <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</lastmod>
  {{- end }}
</url>
{{ end }}
{{ end }}
</urlset>
